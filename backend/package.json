{
  "name": "morelia-conecta-backend",
  "version": "0.2.0",
  "description": "Backend API for Morelia Conecta MaaS MVP",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "bootstrap": "bun run scripts/bootstrap.ts",
    "simulate": "bun run src/simulation/runner.ts",
    "typecheck": "bun x tsc --noEmit"
  },
  "dependencies": {
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.4.0"
  }
}
