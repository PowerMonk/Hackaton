# =============================================================================
# Morelia Conecta Backend Configuration
# Copy to .env and edit as needed
# =============================================================================

# Database (for local development with Docker)
DATABASE_URL=postgres://morelia:morelia_dev_2024@localhost:5432/morelia_conecta

# Geoapify API Key (required for geocoding)
# Get one at https://www.geoapify.com/
GEOAPIFY_API_KEY=

# OSRM Server (optional, uses public demo if not set)
OSRM_BASE_URL=https://router.project-osrm.org

# Server
PORT=3000
HOST=0.0.0.0

# Mode: 'demo' (simulation) or 'live' (real GPS)
MOBILITY_MODE=demo

# Simulation seed for reproducible demos
SIMULATION_SEED=42
